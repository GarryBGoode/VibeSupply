(footprint "LED_D3.0mm_Standoff"
	(version 20241229)
	(generator "manual")
	(layer "F.Cu")
	(descr "3 mm round THT LED standing off the board on its leads (body about 10 mm above the board, in a panel hole). Pads as LED_THT:LED_D3.0mm (pad 1 = cathode, 2.54 mm pitch); the courtyard covers only the pads, so parts lower than the LED body may sit next to it. The body outline is on F.Fab for reference.")
	(tags "LED 3mm standoff panel")
	(property "Reference" "REF**"
		(at 1.27 -2.1 0)
		(layer "F.SilkS")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "Value" "LED_D3.0mm_Standoff"
		(at 1.27 2.6 0)
		(layer "F.Fab")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(attr through_hole)
	(fp_line (start -1.3 -1.1) (end -1.3 1.1) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
	(fp_rect (start -1.15 -1.15) (end 3.69 1.15) (stroke (width 0.05) (type solid)) (fill no) (layer "F.CrtYd"))
	(fp_circle (center 1.27 0) (end 2.77 0) (stroke (width 0.1) (type solid)) (fill no) (layer "F.Fab"))
	(fp_line (start -0.23 -1.16619) (end -0.23 1.16619) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
	(fp_text user "${REFERENCE}"
		(at 1.27 0 0)
		(layer "F.Fab")
		(effects (font (size 0.8 0.8) (thickness 0.12)))
	)
	(pad "1" thru_hole rect (at 0 0) (size 1.8 1.8) (drill 0.9) (layers "*.Cu" "*.Mask"))
	(pad "2" thru_hole circle (at 2.54 0) (size 1.8 1.8) (drill 0.9) (layers "*.Cu" "*.Mask"))
)
